{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.dalil-tounes.com" }],
      "destination": "https://dalil-tounes.com/:path*",
      "permanent": true
    },
    { "source": "/entreprises", "destination": "/businesses", "permanent": true },
    { "source": "/emploi", "destination": "/jobs", "permanent": true },
    { "source": "/emplois", "destination": "/jobs", "permanent": true },
    { "source": "/citizens/sante", "destination": "/citizens/health", "permanent": true },
    { "source": "/citizens/loisirs", "destination": "/citizens/leisure", "permanent": true },
    { "source": "/citizens/magasins", "destination": "/citizens/shops", "permanent": true },
    { "source": "/citizens/tourisme", "destination": "/citizens/tourism", "permanent": true },
    { "source": "/evenements", "destination": "/culture-events", "permanent": true },
    { "source": "/marche-local", "destination": "/marketplace", "permanent": true },
    { "source": "/local-marketplace", "destination": "/marketplace", "permanent": true },
    { "source": "/autour-de-moi", "destination": "/around-me", "permanent": true },
    { "source": "/abonnement", "destination": "/subscription", "permanent": true },
    { "source": "/notre-concept", "destination": "/concept", "permanent": true },
    { "source": "/annuaire-partenaires", "destination": "/partner-directory", "permanent": true },
    { "source": "/#/:path*", "destination": "/:path*", "permanent": true }
  ]
}
